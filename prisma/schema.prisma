generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// Что открывается по адресу «/»:
/// LANDING — витрина с баннером, подборками и преимуществами;
/// CATALOG — каталог товаров, тот же, что на «/products».
enum HomePageVariant {
  LANDING
  CATALOG
}

/// Жизненный цикл сделки при двухэтапной оплате (холдировании):
/// PENDING — платёж создан, покупатель ещё не авторизовал списание;
/// HELD    — средства заморожены на карте, товар передан покупателю,
///           ждём подтверждения приёма;
/// COMPLETED — платёж подтверждён (capture), деньги распределены;
/// FAILED  — платёж не состоялся;
/// REFUNDED — холд снят или деньги возвращены покупателю.
enum PurchaseStatus {
  PENDING
  HELD
  COMPLETED
  FAILED
  REFUNDED
}

/// Платёжный сервис, через который проходит сделка. Провайдер
/// фиксируется в момент создания покупки: подтверждать и возвращать
/// платёж нужно там же, где он был создан.
enum PaymentProvider {
  YOOKASSA
  CLOUDPAYMENTS
  BTCPAY
}

/// Состояние привязки карты продавца для выплат.
enum CardBindingStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Жизненный цикл выплаты:
/// PENDING    — заявка создана и ждёт одобрения администратора;
/// PROCESSING — одобрена, транзакция готовится или уже в сети;
/// COMPLETED  — деньги ушли получателю;
/// FAILED     — заявка отклонена или сорвалась, средства возвращены
///              на баланс.
enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// В чём выплата: рубли с внутреннего баланса или биткоин.
enum PayoutAsset {
  RUB
  BTC
}

/// Кому и за что уходят деньги. Возврат покупателю за биткоин-сделку
/// проводится вручную и попадает в тот же журнал, что и выводы
/// продавцов: это одна и та же исходящая операция с кошелька площадки.
enum PayoutKind {
  SELLER_WITHDRAWAL
  BUYER_REFUND
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUNDED
  RESOLVED_REJECTED
  CLOSED
}

enum DisputeResolution {
  REFUND_BUYER
  REJECT_DISPUTE
  PARTIAL_REFUND
}

enum ReportType {
  PRODUCT
  USER
  REVIEW
  OTHER
}

enum ReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  FRAUD
  COPYRIGHT
  HARASSMENT
  MISLEADING
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  password            String
  role                UserRole  @default(BUYER)
  avatar              String?
  verified            Boolean   @default(false)
  verificationToken   String?   @unique
  verificationTokenExpires DateTime?
  balance             Int       @default(0)
  /// Внутренний баланс в сатоши. Отдельно от рублёвого: биткоин-выручка
  /// фиксируется в момент сделки и до вывода не пересчитывается по курсу.
  /// Int хватает на 21,47 BTC — больше площадка одному продавцу не
  /// накопит, а переполнение Postgres не пропустит молча.
  balanceSats         Int       @default(0)
  /// Куда выводить биткоин. Адрес проверяется при сохранении и
  /// подставляется в заявку на вывод.
  btcPayoutAddress    String?
  btcPayoutAddressSetAt DateTime?
  /// Идентификатор магазина продавца в «ЮKassa для платформ».
  /// Если задан — выручка уходит на его счёт сплитованием, минуя
  /// внутренний баланс; если нет — работает старая схема с балансом
  /// и заявками на выплату.
  yookassaAccountId   String?
  /// Токен карты продавца в CloudPayments — аналог yookassaAccountId
  /// для «Безопасной сделки»: на эту карту уходит выплата при
  /// подтверждении сделки. Появляется после привязки карты и наружу
  /// не отдаётся.
  cloudpaymentsPayoutToken String?
  /// Маска привязанной карты («4242») — чтобы продавец видел, какая
  /// карта подключена, не зная токена.
  cloudpaymentsPayoutCard String?
  /// Когда карта была привязана.
  cloudpaymentsPayoutBoundAt DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  twoFactorBackupCodes String[]  @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  products      Product[]
  purchases     Purchase[]
  payouts       Payout[]
  cardBindings  PayoutCardBinding[]
  reviews       Review[]
  disputes      Dispute[]
  disputeMessages DisputeMessage[]
  reports       Report[]

  @@index([email])
  @@index([role])
  @@index([verificationToken])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  icon        String
  description String?
  parentId    String?
  createdAt   DateTime  @default(now())

  parent      Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryToSubcategory")
  products    Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Int
  coverImage    String?
  fileUrl       String
  fileName      String
  fileSize      Int
  status        ProductStatus @default(DRAFT)
  downloadCount Int           @default(0)
  hasLicenseKeys Boolean      @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])

  purchases     Purchase[]
  reviews       Review[]
  licenseKeys   LicenseKey[]
  images        ProductImage[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
}

model Purchase {
  id                String         @id @default(cuid())
  amount            Int
  commission        Int
  sellerEarnings    Int
  /// Через какой сервис проведена оплата.
  paymentProvider   PaymentProvider @default(YOOKASSA)
  /// Идентификатор платежа у провайдера: payment.id в ЮKassa либо
  /// TransactionId в CloudPayments. Имя колонки осталось прежним,
  /// чтобы не терять данные уже проведённых сделок.
  providerPaymentId String?        @map("yookassaPaymentId")
  status            PurchaseStatus @default(PENDING)
  downloadToken     String?        @unique
  downloadCount     Int            @default(0)
  downloadExpiresAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // --- Эскроу: холдирование и сплитование ---
  /// Момент авторизации (средства заморожены).
  heldAt            DateTime?
  /// Дедлайн провайдера: после него холд снимается сам и деньги
  /// возвращаются покупателю.
  holdExpiresAt     DateTime?
  /// Когда система подтвердит сделку сама, если покупатель молчит.
  autoConfirmAt     DateTime?
  /// Момент подтверждения приёма товара.
  confirmedAt       DateTime?
  /// Кто подтвердил: BUYER | AUTO | DISPUTE | INSTANT (списание без
  /// подтверждения, см. `instantCapture`).
  confirmedBy       String?
  /// Замок на время обращения к API провайдера: не даёт двум запросам
  /// одновременно подтвердить один платёж.
  captureStartedAt  DateTime?
  /// Фактически списанная сумма (при частичном возврате меньше amount).
  capturedAmount    Int?
  /// Сколько уже вернулось покупателю.
  refundedAmount    Int            @default(0)
  /// Транзакции возвратов, уже учтённые в refundedAmount. Нужны там,
  /// где провайдер не отдаёт суммарный возврат по платежу: повторная
  /// доставка уведомления не должна увеличить сумму дважды.
  refundTransactionIds String[]    @default([])
  /// Счёт продавца у провайдера на момент сделки. Заполнен — значит
  /// платёж сплитуется и внутренний баланс продавца не участвует.
  splitAccountId    String?
  /// Накопление «Безопасной сделки» CloudPayments: из него делается
  /// выплата продавцу при подтверждении.
  escrowAccumulationId String?
  /// Транзакция выплаты продавцу. Заполнена — его доля уже ушла
  /// на счёт, начислять её на внутренний баланс нельзя.
  splitPayoutId     String?

  // --- Оплата криптовалютой ---
  /// Сколько сатоши фактически получено по счёту. Именно эта величина,
  /// а не рублёвая цена, делится между продавцом и площадкой: курс
  /// после сделки на расчёт уже не влияет.
  cryptoAmountSats  Int?
  /// Курс на момент оплаты, рублей за 1 BTC. Только для отчётности.
  cryptoRateRub     Int?
  /// Как поделены полученные сатоши при подтверждении сделки.
  cryptoSellerSats     Int?
  cryptoCommissionSats Int?
  /// Сколько сатоши записано к возврату покупателю.
  cryptoRefundedSats   Int  @default(0)

  /// Списывать деньги сразу, не дожидаясь подтверждения приёма товара.
  /// Включается режимом одного продавца и запоминается в самой сделке:
  /// переключатель в админке не должен менять правила уже начатых
  /// покупок — по той же причине, что и `splitAccountId`.
  instantCapture    Boolean        @default(false)

  buyerId           String
  buyer             User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  licenseKeyId      String?        @unique
  licenseKey        LicenseKey?    @relation(fields: [licenseKeyId], references: [id])

  downloadLogs      DownloadLog[]
  dispute           Dispute?

  @@index([buyerId])
  @@index([productId])
  @@index([status])
  @@index([downloadToken])
  @@index([providerPaymentId])
  // Фоновая задача выбирает холды, которым пора подтвердиться
  // или вот-вот истечь.
  @@index([status, autoConfirmAt])
  @@index([status, holdExpiresAt])
}

/// Привязка карты продавца для выплат.
///
/// Токен карты выдаётся только по факту оплаты картой, поэтому карта
/// проверяется авторизацией на символическую сумму, которая тут же
/// снимается. Запись нужна, чтобы связать транзакцию с продавцом:
/// её идентификатор уходит в номер заказа, и подобрать чужой нельзя.
model PayoutCardBinding {
  id            String            @id @default(cuid())
  provider      PaymentProvider   @default(CLOUDPAYMENTS)
  status        CardBindingStatus @default(PENDING)
  amount        Int
  /// Транзакция проверочной авторизации.
  transactionId String?
  /// Маска карты, которую вернул провайдер.
  cardMask      String?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?

  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Исходящая операция с денег площадки: вывод продавца или возврат
/// покупателю. Сумма списывается с внутреннего баланса в момент подачи
/// заявки — иначе один и тот же остаток можно вывести дважды. Если
/// заявка отклонена, списание возвращается.
model Payout {
  id             String       @id @default(cuid())
  asset          PayoutAsset  @default(RUB)
  kind           PayoutKind   @default(SELLER_WITHDRAWAL)
  /// Сумма в копейках — для рублёвых выплат.
  amount         Int          @default(0)
  status         PayoutStatus @default(PENDING)
  method         String?
  accountDetails String?
  requestedAt    DateTime     @default(now())
  processedAt    DateTime?

  // --- Биткоин ---
  /// Списано с баланса, включая удержанную комиссию за вывод.
  amountSats     Int?
  /// Комиссия сети, удержанная из суммы.
  feeSats        Int?
  /// Сколько уходит на адрес получателя.
  netSats        Int?
  /// Ставка, по которой считалась комиссия, сат/vB. Для разбора
  /// расхождений между котировкой и фактической транзакцией.
  feeRate        Float?
  /// Адрес получателя. У ручного возврата покупателю он появляется
  /// не сразу: адрес нужно ещё запросить.
  destination    String?
  /// Идентификатор выплаты в BTCPay — по нему приходят уведомления.
  providerPayoutId String?    @unique
  /// Транзакция в сети, когда она известна.
  txId           String?
  /// Причина отказа или комментарий администратора.
  note           String?
  /// Сделка, из-за которой возник возврат.
  purchaseId     String?

  /// Получатель: продавец при выводе, покупатель при возврате.
  recipientId    String       @map("sellerId")
  recipient      User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([status])
  @@index([kind, status])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@index([productId])
}

model DownloadLog {
  id           String   @id @default(cuid())
  ipAddress    String?
  userAgent    String?
  downloadedAt DateTime @default(now())

  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model LicenseKey {
  id          String    @id @default(cuid())
  key         String
  isSold      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  soldAt      DateTime?

  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  purchase    Purchase?

  @@index([productId])
  @@index([isSold])
}

model ProductImage {
  id        String   @id @default(cuid())
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([order])
}

model PlatformSettings {
  id                      String   @id @default(cuid())
  siteName                String   @default("DigiMarket")
  siteDescription         String   @default("Маркетплейс цифровых товаров")
  supportEmail            String   @default("support@digimarket.com")
  commissionRate          Int      @default(10)
  minPayoutAmount         Int      @default(100000)
  /// Минимальная сумма вывода биткоина, в сатоши. Мелкие выводы
  /// съедаются комиссией сети, поэтому порог нужен отдельный.
  btcMinPayoutSats        Int      @default(50000)
  /// Границы удерживаемой комиссии за вывод, в сатоши: оценка сети
  /// зажимается между ними, чтобы всплеск в мемпуле не сделал вывод
  /// разорительным, а провал — убыточным для площадки.
  btcPayoutFeeMinSats     Int      @default(500)
  btcPayoutFeeMaxSats     Int      @default(30000)
  /// За сколько блоков транзакция должна попасть в цепочку.
  btcPayoutFeeBlockTarget Int      @default(6)
  /// Расчётный размер транзакции вывода, vB. Точный размер известен
  /// только при подписи, поэтому берётся типовой (2 входа, 2 выхода).
  btcPayoutTxVsize        Int      @default(200)
  /// Сколько минут действует показанная продавцу котировка.
  btcPayoutQuoteMinutes   Int      @default(15)
  maxFileSize             Int      @default(500)
  notifyNewUser           Boolean  @default(true)
  notifyNewProduct        Boolean  @default(true)
  notifyNewPurchase       Boolean  @default(true)
  notifyPayoutRequest     Boolean  @default(true)
  notifyReportSubmission  Boolean  @default(false)
  requireEmailVerification Boolean @default(false)
  enableTwoFactor         Boolean  @default(false)
  sessionTimeout          Int      @default(24)
  maxLoginAttempts        Int      @default(5)
  /// Площадка одного продавца: регистрация продавцов закрыта, товары
  /// выставляет только администратор, а деньги по сделкам целиком
  /// приходят на счёт площадки — сплитование не применяется, даже если
  /// у продавца сохранились реквизиты у провайдера.
  singleVendorMode        Boolean  @default(false)
  /// Витрина продавцов /stores: страница и пункт меню. Выключатель
  /// отдельный от `singleVendorMode`, потому что случаи не совпадают:
  /// список магазинов убирают и на площадке с несколькими продавцами,
  /// когда покупателя ведут по каталогу, а не по витринам.
  storesPageEnabled       Boolean  @default(true)
  /// Что показывать по адресу «/»: витрину-лендинг или сразу каталог
  /// товаров. Меняется только содержимое главной — адрес «/products»
  /// остаётся рабочим, чтобы прежние ссылки и меню никуда не делись.
  homePage                HomePageVariant @default(LANDING)
  maintenanceMode         Boolean  @default(false)
  maintenanceMessage      String   @default("Сайт временно недоступен. Ведутся технические работы.")
  smtpHost                String?
  smtpPort                Int      @default(587)
  smtpUser                String?
  smtpPassword            String?
  fromEmail               String   @default("noreply@digimarket.com")
  fromName                String   @default("DigiMarket")
  updatedAt               DateTime @updatedAt
}

model Dispute {
  id              String          @id @default(cuid())
  reason          String
  status          DisputeStatus   @default(OPEN)
  resolution      DisputeResolution?
  resolutionNote  String?
  refundAmount    Int?
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime        @updatedAt

  purchaseId      String          @unique
  purchase        Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  buyerId         String
  buyer           User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  messages        DisputeMessage[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model DisputeMessage {
  id          String   @id @default(cuid())
  message     String
  isFromBuyer Boolean
  createdAt   DateTime @default(now())

  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  senderId    String
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([createdAt])
}

model Report {
  id              String        @id @default(cuid())
  type            ReportType
  reason          ReportReason
  description     String
  status          ReportStatus  @default(PENDING)
  adminNote       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  resolvedAt      DateTime?

  reporterId      String
  reporter        User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  // Nullable references to what's being reported
  reportedUserId  String?
  reportedProductId String?
  reportedReviewId String?

  @@index([reporterId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}
